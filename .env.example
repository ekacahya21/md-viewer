# MD Viewer Environment Configuration
PORT=80
DB_PATH=/data/shared_docs.db

# Optional: Salt for view count deduplication hashing
VIEW_SALT=change-me-to-a-random-salt-for-production

# Optional: Google Search Console verification meta tag content
GOOGLE_SITE_VERIFICATION=

# Optional: 9router or any OpenAI-compatible LLM endpoint for AI Document Summary
LOCAL_LLM_HOST=http://127.0.0.1:20128/v1
LOCAL_LLM_KEY=your_api_key_here
LOCAL_LLM_MODEL=ag/gemini-3.7-flash-low
