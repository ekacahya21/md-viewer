{
  "name": "md-viewer",
  "version": "1.1.0",
  "description": "Minimalist editorial Markdown studio & reader with native Mermaid diagrams, KaTeX math formulas, zero-signup document sharing, and distraction-free typography.",
  "author": "Eka Cahya",
  "license": "MIT",
  "homepage": "https://md-viewer.e21.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ekacahya21/md-viewer.git"
  },
  "keywords": [
    "markdown",
    "editor",
    "reader",
    "mermaid",
    "katex",
    "editorial",
    "minimalist",
    "note-taking"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.5.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test tests/**/*.test.mjs",
    "preview": "vite preview",
    "deploy": "./scripts/deploy.sh",
    "deploy:dry-run": "./scripts/deploy.sh --dry-run",
    "rollback": "./scripts/rollback.sh"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "@types/prismjs": "^1.26.6",
    "dompurify": "^3.4.16",
    "express": "^5.2.1",
    "katex": "^0.18.9",
    "lucide-react": "^1.49.0",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
